{
  "name": "fundamental-physics-group-site",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "admin:reset": "node --import tsx scripts/reset-admin.ts",
    "check:project": "node scripts/check-project.mjs",
    "db:migrate": "prisma migrate dev",
    "setup": "node scripts/setup.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "bcryptjs": "3.0.2",
    "next": "15.5.16",
    "next-auth": "4.24.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.0.2",
    "postcss": "8.5.6",
    "prisma": "6.14.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "sharp": true
  }
}
