DATABASE_URL="file:../data/site.db"
SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERATE_ON_SETUP"
ENABLE_ADMIN="false"
UPLOAD_DIR="data/uploads"
PEOPLE_PHOTO_DIR="public/people"
BIND_HOST="127.0.0.1"
PORT="3000"

# Google Drive-managed Research Assistant profiles
GOOGLE_DRIVE_ROOT_FOLDER_ID="10_rzMMevZi6_T-bajAnmaynab0UbDBtv"
# Optional: set this if the Research Assistants folder is not auto-discovered.
GOOGLE_DRIVE_RA_FOLDER_ID=""
# For a public shared folder, a restricted Google Drive API key is sufficient.
GOOGLE_DRIVE_API_KEY=""
# Preferred alternative for private/controlled access: the complete service-account JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
DRIVE_DEFAULT_AFFILIATION="BRAC University"
DRIVE_PEOPLE_ASSET_DIR="data/drive-people"

# INSPIRE group-level citation cache
INSPIRE_AUTHORS_FILE="config/inspire-authors.json"
INSPIRE_STATS_FILE="data/inspire-stats.json"
INSPIRE_REFRESH_HOURS="24"
